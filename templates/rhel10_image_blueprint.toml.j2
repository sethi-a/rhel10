#jinja2: trim_blocks:True, lstrip_blocks:True
# {{ ansible_managed }}
# Generated from vars/rhel10_image_config.yml + rhel10_cis_profile.yml
# Platform: {{ platform_name }}
# Do not edit manually — regenerate with: ansible-playbook playbooks/generate_blueprint_toml.yml

name = "qbe-rhel10-{{ platform_name }}"
description = "QBE RHEL 10 Baseline for {{ platform_name | capitalize }} - CIS Level 1 Compliant"
version = "{{ image_config.version }}"
modules = []
groups = []

# ---------------------------------------------------------------------------
# Packages — image-build common (from image_config.common_packages)
# ---------------------------------------------------------------------------
# Only packages needed at image build time. All other packages from
# packages.required (core OS, security, agents) are installed at Day 1
# by their respective roles from Satellite custom repos.
{% for pkg in image_config.common_packages %}
[[packages]]
name = "{{ pkg }}"
version = "*"
{% endfor %}

# ---------------------------------------------------------------------------
# Packages — platform-specific (from group_vars/platform_{{ platform_name }})
# ---------------------------------------------------------------------------
{% for pkg in platform_packages %}
[[packages]]
name = "{{ pkg.name }}"
version = "{{ pkg.version if pkg.version else '*' }}"
{% endfor %}

[customizations]

# ---------------------------------------------------------------------------
# Packages — prohibited (from rhel10_image_config.yml)
# ---------------------------------------------------------------------------
{% for pkg in image_config.prohibited_packages %}
[[customizations.packages]]
name = "{{ pkg.name }}"
exclude = true
{% endfor %}

# ---------------------------------------------------------------------------
# Filesystem layout (sizes from image_config.partitions, mount options from
# image_config.filesystem_mounts where the mountpoint matches)
# ---------------------------------------------------------------------------
{% for part in image_config.partitions %}
[[customizations.filesystem]]
mountpoint = "{{ part.mountpoint }}"
size = {{ part.size }}
type = "{{ part.type }}"
{% if part.mountpoint in image_config.filesystem_mounts %}
options = "{{ image_config.filesystem_mounts[part.mountpoint].options | join(',') }}"
{% endif %}
{% endfor %}

# ---------------------------------------------------------------------------
# Kernel boot parameters
# ---------------------------------------------------------------------------
[customizations.kernel]
append = "{{ image_config.kernel_append }}"

# ---------------------------------------------------------------------------
# Service accounts
# ---------------------------------------------------------------------------
{% for user in image_config.users %}
[[customizations.user]]
name = "{{ user.name }}"
description = "{{ user.description }}"
{% if user.groups is defined %}
groups = {{ user.groups | to_json }}
{% endif %}
uid = {{ user.uid }}
gid = {{ user.gid }}
{% endfor %}

# ---------------------------------------------------------------------------
# SSH authorised keys
# ---------------------------------------------------------------------------
{% for user in image_config.users %}
{% if user.ssh_key is defined %}
[[customizations.sshkey]]
user = "{{ user.name }}"
key = "{{ user.ssh_key }}"
{% endif %}
{% endfor %}

# ---------------------------------------------------------------------------
# Timezone and locale
# ---------------------------------------------------------------------------
[customizations.timezone]
timezone = "{{ image_config.timezone }}"

[customizations.locale]
languages = {{ image_config.locale.languages | to_json }}
keyboard = "{{ image_config.locale.keyboard }}"

# ---------------------------------------------------------------------------
# Firewall
# ---------------------------------------------------------------------------
[customizations.firewall]
enabled = true

[[customizations.firewall.services]]
enabled = ["ssh"]

# ---------------------------------------------------------------------------
# OpenSCAP — CIS Level 1 profile with QBE tailoring
# (from group_vars/all/rhel10_cis_profile.yml)
# ---------------------------------------------------------------------------
[customizations.openscap]
profile_id = "{{ cis_profile.base_profile }}"
datastream = "{{ cis_profile.content_path }}"
tailoring_file = "{{ cis_profile.tailoring_path }}"
