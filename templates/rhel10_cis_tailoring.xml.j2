#jinja2: trim_blocks: True, lstrip_blocks: True
<?xml version="1.0" encoding="UTF-8"?>
{#- templates/cis_tailoring.xml.j2
    Generated by: playbooks/generate_tailoring_xml.yml
    Source:       group_vars/all/cis_profile.yml
    DO NOT EDIT THIS OUTPUT FILE — edit cis_profile.yml and regenerate.
-#}
<xccdf-1.2:Tailoring xmlns:xccdf-1.2="http://checklists.nist.gov/xccdf/1.2"
                     id="{{ cis_profile.tailoring_id }}"
                     version="1"
                     date="{{ ansible_date_time.date }}T{{ ansible_date_time.time }}">
  <xccdf-1.2:benchmark href="{{ cis_profile.content_path }}"/>
  <xccdf-1.2:version time="{{ ansible_date_time.iso8601 }}">1</xccdf-1.2:version>
  <xccdf-1.2:Profile id="{{ cis_profile.base_profile }}_tailored"
                      extends="{{ cis_profile.base_profile }}">
    <xccdf-1.2:title override="true">QBE CIS Level 1 Server — RHEL 10 (Tailored)</xccdf-1.2:title>
    <xccdf-1.2:description override="true">CIS Level 1 Server benchmark for RHEL 10, customised for QBE. Disabled rules and modified values are maintained in group_vars/all/cis_profile.yml.</xccdf-1.2:description>
{%- for rule in cis_profile.disabled_rules | default([]) %}
    <!-- {{ rule.reason }} -->
    <xccdf-1.2:select idref="{{ rule.rule_id }}" selected="false"/>
{%- endfor %}
{%- for rule in cis_profile.modified_rules | default([]) %}
    <!-- {{ rule.reason }} -->
    <xccdf-1.2:set-value idref="{{ rule.value_id }}">{{ rule.value }}</xccdf-1.2:set-value>
{%- endfor %}
  </xccdf-1.2:Profile>
</xccdf-1.2:Tailoring>
