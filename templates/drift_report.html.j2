<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>RHEL 10 Drift Detection Report — {{ report_data.scan_date }}</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 2em; color: #333; }
    h1 { color: #1a1a1a; border-bottom: 2px solid #cc0000; padding-bottom: 0.3em; }
    h2 { color: #444; margin-top: 1.5em; }
    .summary { display: flex; gap: 1.5em; margin: 1em 0; }
    .card { background: #f8f8f8; border: 1px solid #ddd; border-radius: 6px; padding: 1em 1.5em; min-width: 140px; }
    .card .value { font-size: 2em; font-weight: bold; }
    .card.clean .value { color: #2e7d32; }
    .card.drifted .value { color: #c62828; }
    .card.total .value { color: #1565c0; }
    table { border-collapse: collapse; width: 100%; margin: 1em 0; }
    th, td { border: 1px solid #ddd; padding: 0.5em 0.8em; text-align: left; }
    th { background: #f0f0f0; font-weight: 600; }
    tr:nth-child(even) { background: #fafafa; }
    .severity-critical { color: #fff; background: #b71c1c; padding: 2px 6px; border-radius: 3px; }
    .severity-major { color: #fff; background: #e65100; padding: 2px 6px; border-radius: 3px; }
    .severity-moderate { color: #fff; background: #f9a825; padding: 2px 6px; border-radius: 3px; }
    .severity-minor { color: #333; background: #e0e0e0; padding: 2px 6px; border-radius: 3px; }
    .status-compliant { color: #2e7d32; font-weight: bold; }
    .status-drifted { color: #c62828; font-weight: bold; }
    .aide-alert { color: #c62828; font-weight: bold; }
    .aide-clean { color: #2e7d32; }
    footer { margin-top: 2em; padding-top: 1em; border-top: 1px solid #ddd; color: #888; font-size: 0.85em; }
  </style>
</head>
<body>
  <h1>RHEL 10 Configuration Drift Report</h1>
  <p><strong>Scan Date:</strong> {{ report_data.scan_date }}</p>

  <div class="summary">
    <div class="card total">
      <div class="value">{{ report_data.total_scanned }}</div>
      <div>Hosts Scanned</div>
    </div>
    <div class="card clean">
      <div class="value">{{ report_data.total_clean }}</div>
      <div>Compliant</div>
    </div>
    <div class="card drifted">
      <div class="value">{{ report_data.total_drifted }}</div>
      <div>Drifted ({{ report_data.drift_percentage }}%)</div>
    </div>
  </div>

{% if report_data.drifted_hosts | length > 0 %}
  <h2>Drifted Hosts</h2>
  <table>
    <thead>
      <tr>
        <th>Hostname</th>
        <th>Region</th>
        <th>Environment</th>
        <th>Platform</th>
        <th>Drift Items</th>
        <th>Max Severity</th>
        <th>Categories</th>
        <th>AIDE</th>
        <th>Auto-Remediate</th>
      </tr>
    </thead>
    <tbody>
{% for host in report_data.drifted_hosts %}
      <tr>
        <td>{{ host.hostname }}</td>
        <td>{{ host.region }}</td>
        <td>{{ host.environment }}</td>
        <td>{{ host.platform | default('—') }}</td>
        <td>{{ host.baseline_drift.total_drift }}</td>
        <td><span class="severity-{{ host.baseline_drift.max_severity }}">{{ host.baseline_drift.max_severity | upper }}</span></td>
        <td>{{ host.baseline_drift.categories | dict2items | selectattr('value.status', 'equalto', 'drifted') | map(attribute='key') | join(', ') }}</td>
        <td class="{{ host.aide_drift | ternary('aide-alert', 'aide-clean') }}">{{ host.aide_drift | ternary('ALERT', 'Clean') }}</td>
        <td>{{ host.auto_remediate | ternary('Yes', 'No') }}</td>
      </tr>
{% endfor %}
    </tbody>
  </table>

{% for host in report_data.drifted_hosts %}
  <h3>{{ host.hostname }} — Drift Details</h3>
  <table>
    <thead>
      <tr>
        <th>Category</th>
        <th>Status</th>
        <th>Item</th>
        <th>Expected</th>
        <th>Actual</th>
        <th>Severity</th>
      </tr>
    </thead>
    <tbody>
{% for cat_name, cat_data in host.baseline_drift.categories.items() %}
{% if cat_data.status == 'drifted' %}
{% for item in cat_data.drift_items %}
      <tr>
        <td>{{ cat_name }}</td>
        <td class="status-drifted">Drifted</td>
        <td>{{ item.item }}</td>
        <td>{{ item.expected }}</td>
        <td>{{ item.actual }}</td>
        <td><span class="severity-{{ item.severity }}">{{ item.severity | upper }}</span></td>
      </tr>
{% endfor %}
{% endif %}
{% endfor %}
    </tbody>
  </table>
{% endfor %}

{% endif %}

{% if report_data.clean_hosts | length > 0 %}
  <h2>Compliant Hosts</h2>
  <table>
    <thead>
      <tr>
        <th>Hostname</th>
        <th>Region</th>
        <th>Environment</th>
        <th>Platform</th>
        <th>Scan Time</th>
      </tr>
    </thead>
    <tbody>
{% for host in report_data.clean_hosts %}
      <tr>
        <td>{{ host.hostname }}</td>
        <td>{{ host.region }}</td>
        <td>{{ host.environment }}</td>
        <td>{{ host.platform | default('—') }}</td>
        <td>{{ host.scan_timestamp }}</td>
      </tr>
{% endfor %}
    </tbody>
  </table>
{% endif %}

  <footer>
    Generated by RHEL 10 Drift Detection — AAP Automation | {{ report_data.scan_date }}
  </footer>
</body>
</html>
