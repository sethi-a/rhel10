<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Drift Report — {{ report_data.scan_date }}</title>
  <style>
    body { font-family: sans-serif; margin: 2em; }
    table { border-collapse: collapse; width: 100%; margin: 1em 0; }
    th, td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
    th { background: #eee; }
    .red { color: #c00; font-weight: bold; }
    .green { color: #060; font-weight: bold; }
  </style>
</head>
<body>

<h1>RHEL 10 Drift Report</h1>
<p>Scan Date: {{ report_data.scan_date }}</p>
<p>Scanned: {{ report_data.total_scanned }} | Compliant: {{ report_data.total_clean }} | Drifted: <span class="red">{{ report_data.total_drifted }} ({{ report_data.drift_percentage }}%)</span></p>

{% if report_data.drifted_hosts | length > 0 %}
<h2>Drifted Hosts</h2>
<table>
  <tr>
    <th>Hostname</th>
    <th>Region</th>
    <th>Environment</th>
    <th>Drift Items</th>
  </tr>
{% for host in report_data.drifted_hosts %}
  <tr>
    <td>{{ host.hostname }}</td>
    <td>{{ host.region }}</td>
    <td>{{ host.environment }}</td>
    <td>{{ host.baseline_drift.total_drift }}</td>
  </tr>
{% endfor %}
</table>
{% endif %}

{% if report_data.clean_hosts | length > 0 %}
<h2>Compliant Hosts</h2>
<table>
  <tr>
    <th>Hostname</th>
    <th>Region</th>
    <th>Environment</th>
  </tr>
{% for host in report_data.clean_hosts %}
  <tr>
    <td>{{ host.hostname }}</td>
    <td>{{ host.region }}</td>
    <td>{{ host.environment }}</td>
  </tr>
{% endfor %}
</table>
{% endif %}

<p><small>Generated by AAP Automation | {{ report_data.scan_date }}</small></p>
</body>
</html>
